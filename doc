#!/Users/amadad/.local/share/uv/tools/docling/bin/python
"""doc — PDF → Markdown with a live progress bar (docling, driven page-by-page).

  doc book.pdf                 standard pipeline (heron layout + Apple Vision OCR if scanned + TableFormer)
  doc --vlm book.pdf           Granite-Docling MLX VLM — one model does layout+OCR+tables
  doc --vlm --resume book.pdf  continue an interrupted run
  doc --describe book.pdf      standard OCR + MiniCPM-V 4.6 caption of each figure, inline

Output: <book>.md next to the source PDF (override with --out DIR).

Why page-by-page: docling exposes no progress callback for convert(), so the only
robust way to show "page 47/232 · ETA 3m" is to loop convert(page_range=(i,i)) over
one reused converter (model loads once). Each page is flushed to disk immediately,
so a crash keeps finished pages and --resume picks up where it stopped.
"""
import argparse, json, logging, os, sys, warnings
from pathlib import Path

# kill docling/HF's own tqdm + transformers chatter so only our rich bar shows
os.environ.setdefault("TQDM_DISABLE", "1")
os.environ.setdefault("HF_HUB_DISABLE_PROGRESS_BARS", "1")
warnings.filterwarnings("ignore")
for _n in ("docling", "transformers", "httpx", "huggingface_hub", "mlx", "PIL"):
    logging.getLogger(_n).setLevel(logging.ERROR)

import pypdfium2 as pdfium
from rich.console import Console
from rich.progress import (
    Progress, SpinnerColumn, BarColumn, TextColumn,
    MofNCompleteColumn, TimeElapsedColumn, TimeRemainingColumn,
)
from docling.document_converter import DocumentConverter, PdfFormatOption
from docling.datamodel.base_models import InputFormat

console = Console()


def build_converter(use_vlm: bool) -> DocumentConverter:
    """One converter, reused for every page so the model loads only once."""
    if not use_vlm:
        return DocumentConverter()
    from docling.pipeline.vlm_pipeline import VlmPipeline
    from docling.datamodel.pipeline_options import VlmPipelineOptions
    from docling.datamodel import vlm_model_specs
    opts = VlmPipelineOptions(vlm_options=vlm_model_specs.GRANITEDOCLING_MLX)
    return DocumentConverter(format_options={
        InputFormat.PDF: PdfFormatOption(pipeline_cls=VlmPipeline, pipeline_options=opts)
    })


def _cols():
    return [
        SpinnerColumn(), TextColumn("[bold blue]{task.description}"),
        BarColumn(), MofNCompleteColumn(),
        TextColumn("· elapsed"), TimeElapsedColumn(),
        TextColumn("· ETA"), TimeRemainingColumn(),
    ]


def describe_flow(args, out: Path) -> int:
    """Standard OCR pass, then caption each figure with MiniCPM-V 4.6 (isolated env), inline."""
    import subprocess, tempfile
    from docling.datamodel.pipeline_options import PdfPipelineOptions
    from docling_core.types.doc import ImageRefMode
    from docling_core.types.doc.document import PictureDescriptionData

    console.print(f"[bold]{args.pdf.name}[/]  ·  describe (OCR + MiniCPM-V 4.6 figure captions)  ·  → {out}")
    opts = PdfPipelineOptions()
    opts.generate_picture_images = True   # so the VLM gets the actual figure crop
    opts.images_scale = 2.0
    conv = DocumentConverter(format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)})
    with console.status("[dim]converting + extracting figures…[/]"):
        doc = conv.convert(str(args.pdf), raises_on_error=False).document

    pics = list(doc.pictures)
    console.print(f"  {len(pics)} figure(s) found")
    if not pics:
        out.write_text(doc.export_to_markdown(image_mode=ImageRefMode.PLACEHOLDER))
        console.print(f"[green]done[/] — no figures → {out}")
        return 0

    tmp = Path(tempfile.mkdtemp(prefix="doc-figs-"))
    saved = []
    for i, pic in enumerate(pics):
        img = pic.get_image(doc)
        if img is None:
            saved.append(None); continue
        fp = tmp / f"{i:04d}.png"
        img.convert("RGB").save(fp)
        saved.append(fp.name)

    # caption in MiniCPM-V 4.6's OWN env (mlx-vlm) via PEP-723 uv run.
    # .resolve() follows the ~/.local/bin/doc symlink back to the repo so the
    # sidecar is found beside this script.
    script = Path(__file__).resolve().with_name("minicpm-describe.py")
    length = "short" if getattr(args, "short", False) else "normal"
    proc = subprocess.Popen(
        ["uv", "run", "--quiet", str(script), str(tmp), length],
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        env={**os.environ, "HF_HUB_CACHE": os.environ.get("HF_HUB_CACHE", str(Path.home() / "models"))},
    )
    n = sum(1 for s in saved if s)
    with Progress(*_cols(), console=console) as prog:
        task = prog.add_task("loading MiniCPM…", total=n)
        for line in proc.stdout:
            line = line.strip()
            if line.startswith("READY"):
                prog.update(task, description="describing figures")
            elif line.startswith("DONE"):
                prog.advance(task)
    proc.wait()

    caps_file = tmp / "captions.json"
    caps = json.loads(caps_file.read_text()) if caps_file.exists() else {}
    for i, pic in enumerate(pics):
        cap = caps.get(saved[i]) if saved[i] else None
        if cap:
            pic.annotations.append(PictureDescriptionData(text=cap, provenance="minicpm-v-4.6"))

    out.write_text(doc.export_to_markdown(image_mode=ImageRefMode.PLACEHOLDER, include_annotations=True))
    console.print(f"[green]done[/] — {n} figure(s) described → {out}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="doc", description="PDF → Markdown with a progress bar")
    ap.add_argument("pdf", type=Path)
    ap.add_argument("--vlm", action="store_true", help="Granite-Docling MLX VLM (vs standard pipeline)")
    ap.add_argument("--describe", action="store_true", help="OCR + MiniCPM-V 4.6 caption of each figure, inline")
    ap.add_argument("--short", action="store_true", help="shorter figure captions (~1.9x faster, less detail)")
    ap.add_argument("--out", type=Path, help="output directory (default: next to the source PDF)")
    ap.add_argument("--resume", action="store_true", help="skip pages already written")
    args = ap.parse_args()

    if not args.pdf.exists():
        console.print(f"[red]not found:[/] {args.pdf}")
        return 1

    out_dir = args.out or args.pdf.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    out = out_dir / (args.pdf.stem + ".md")

    if args.describe:
        return describe_flow(args, out)

    state = out.parent / (out.name + ".state.json")
    n_pages = len(pdfium.PdfDocument(str(args.pdf)))

    done = set()
    if args.resume and state.exists():
        done = set(json.loads(state.read_text()).get("done", []))
        fh = out.open("a")
        console.print(f"[yellow]resuming[/] — {len(done)}/{n_pages} pages already done")
    else:
        fh = out.open("w")  # fresh run truncates

    mode = "Granite MLX VLM" if args.vlm else "standard"
    console.print(f"[bold]{args.pdf.name}[/]  ·  {n_pages} pages  ·  {mode}  ·  → {out}")
    with console.status("[dim]loading model…[/]"):
        conv = build_converter(args.vlm)

    with Progress(*_cols(), console=console) as prog:
        task = prog.add_task("starting", total=n_pages, completed=len(done))
        for i in range(1, n_pages + 1):
            if i in done:
                continue
            prog.update(task, description=f"page {i}")
            try:
                res = conv.convert(str(args.pdf), page_range=(i, i), raises_on_error=False)
                md = res.document.export_to_markdown()
            except Exception as e:  # one bad page shouldn't kill the whole book
                md = f"\n<!-- doc: page {i} failed: {e} -->\n"
            fh.write(md + "\n\n")
            fh.flush()
            done.add(i)
            state.write_text(json.dumps({"done": sorted(done), "pages": n_pages}))
            prog.advance(task)

    fh.close()
    if len(done) == n_pages:
        state.unlink(missing_ok=True)  # clean run — drop the resume sidecar
    console.print(f"[green]done[/] — {len(done)}/{n_pages} pages → {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
